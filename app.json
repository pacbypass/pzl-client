{
  "expo": {
    "name": "Polowanie",
    "slug": "pzl-client",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "pzlrev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#96d784"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.pacbypass.polowanie",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplikacja pokazuje Twoją pozycję na mapie łowieckiej, aby ułatwić sprawdzenie, w którym rewirze się znajdujesz.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "pl.pacbypass.polowanie",
      "adaptiveIcon": {
        "backgroundColor": "#2f6b26"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikacja używa lokalizacji do wyświetlania Twojej pozycji na mapie łowieckiej."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidAuto"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.systemkl2.pzlow.pl",
      "authIssuer": "https://auth.systemkl2.pzlow.pl",
      "geoBaseUrl": "https://geo.systemkl2.pzlow.pl",
      "oidcClientId": "pzl-mobile-client",
      "router": {},
      "eas": {
        "projectId": "bd6e2c11-4c8b-4749-9086-59ad168a38c1"
      }
    },
    "owner": "pacbypass"
  }
}
